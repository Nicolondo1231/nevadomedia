# Copy to .env and fill in your key. .env is git-ignored — never commit the key.
POPPY_API_KEY=gp_your_key_here

POPPY_API_BASE=https://api.getpoppy.ai
POPPY_BOARD_ID=thankful-leaf-BPYip
POPPY_CHAT_ID=chatNode-polished-forest-fL8_S

# Default target for `send`: the "Hello Chat" thread, with the exchange
# persisted so it shows up on the Poppy board. Clear POPPY_CONVERSATION_ID to
# make `send` query the bare knowledgebase instead.
POPPY_CONVERSATION_ID=eaa067d0-5886-496a-8e01-a754842c463f
POPPY_SAVE_HISTORY=true

# Defaults for every call
POPPY_MODEL=claude-sonnet-5
POPPY_MAX_TOKENS=4000
POPPY_TEMPERATURE=0
