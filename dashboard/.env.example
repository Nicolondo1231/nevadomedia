# Frontend environment. Copy to .env.local for local dev; set the same two
# variables in Netlify under Site configuration -> Environment variables.
#
# Only these two belong in the browser bundle. The anon key is safe to ship —
# Row Level Security decides what each signed-in role can read. The service
# role key must NEVER appear here; it lives only on the Hostinger VPS worker.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — set these in Netlify's UI, never in this file and never
# in a VITE_ variable. They are read by the Netlify functions that sync Meta.
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   META_ACCESS_TOKEN
