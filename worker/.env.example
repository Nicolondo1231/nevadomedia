# Worker environment. Lives ONLY on the Hostinger VPS — never in the frontend,
# never committed. chmod 600 this file.

# Supabase. The service role key bypasses RLS so the worker can write synced
# data; it must never leave the VPS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta Marketing API. A System User token, which does not expire.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Shared secret the dashboard's "Refresh Data" button presents. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_REFRESH_TOKEN=

# Origin allowed to call /refresh from a browser (the Netlify site URL).
ALLOWED_ORIGIN=https://your-site.netlify.app

PORT=8787
# Daily refresh, in this timezone. 07:00 EST per spec.
CRON_TZ=America/New_York
CRON_SCHEDULE=0 7 * * *
